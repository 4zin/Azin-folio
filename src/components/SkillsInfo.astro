---
import jsIcon from '@/assets/images/js-icon.webp';
import tsIcon from '@/assets/images/ts-icon.webp';
import htmlIcon from '@/assets/images/html-icon.webp';
import cssIcon from '@/assets/images/css-icon.webp';
import nextIcon from '@/assets/images/next-icon.webp';
import astroIcon from '@/assets/images/astro-icon.webp';
import postgreIcon from '@/assets/images/postgre-icon.webp';
import liquidIcon from '@/assets/images/liquid-icon.webp';
import nestIcon from '@/assets/images/nest-icon.webp';
import reactIcon from '@/assets/images/react-icon.webp';

import Image from 'astro/components/Image.astro';

type Skill = {
  name: string;
  icon: ImageMetadata;
};

const skills: Skill[] = [
  { name: 'Javascript', icon: jsIcon },
  { name: 'Typecript', icon: tsIcon },
  { name: 'HTML5', icon: htmlIcon },
  { name: 'CSS', icon: cssIcon },
  { name: 'NextJs', icon: nextIcon },
  { name: 'Astro', icon: astroIcon },
  { name: 'Posgree SQL', icon: postgreIcon },
  { name: 'Liquid', icon: liquidIcon },
  { name: 'NestJs', icon: nestIcon },
  { name: 'React JS', icon: reactIcon },
];
---

<div
  data-content="0"
  id="panel-0"
  role="tabpanel"
  aria-labelledby="tab-0"
  tabindex="0"
  class="active grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5 lg:gap-5"
>
  <style>
    .skill-tile {
      background: linear-gradient(
        180deg,
        rgba(255, 255, 255, 0.4),
        rgba(223, 196, 169, 0.35)
      );
      border: 2px solid color-mix(in srgb, var(--color-ink) 70%, transparent);
      border-radius: 6px;
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.5),
        0 2px 0 -1px rgba(46, 38, 38, 0.3);
      transition:
        transform 0.18s steps(3, end),
        box-shadow 0.2s ease,
        border-color 0.2s ease;
    }

    .skill-tile:hover {
      transform: translateY(-3px);
      border-color: var(--color-primary);
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.6),
        0 4px 0 -1px rgba(46, 38, 38, 0.35),
        0 0 18px var(--glow-mid);
    }

    .skill-icon {
      transition: transform 0.2s steps(3, end);
    }
    .skill-tile:hover .skill-icon {
      transform: scale(1.12);
    }
  </style>
  {
    skills.map((skill) => (
      <div class="skill-tile group flex flex-col items-center justify-center gap-y-4 p-3 lg:aspect-square lg:gap-y-6 lg:p-5">
        <Image
          src={skill.icon}
          alt={skill.name}
          class="skill-icon 3xl:h-[50%] 3xl:w-[50%] h-12 w-12 object-contain lg:h-11/12 lg:w-11/12"
          loading={'eager'}
        />
        <span class="font-primary text-text 3xl:text-[14px] text-center text-[7px] leading-tight">
          {skill.name}
        </span>
      </div>
    ))
  }
</div>
