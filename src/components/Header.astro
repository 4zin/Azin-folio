---
import MuteButton from './MuteButton.astro';
---

<header
  class={`flex w-full items-center p-5 lg:absolute lg:top-5 lg:right-5 lg:w-[95%] lg:p-0 ${Astro.url.pathname === '/' ? 'absolute justify-end' : 'justify-between'}`}
>
  <a
    href="/"
    class={`${Astro.url.pathname === '/' ? 'hidden' : ''} font-primary text-text`}
  >
    Home
  </a>
  <MuteButton />
</header>
