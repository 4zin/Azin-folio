---
import { Image } from 'astro:assets';
import { projects } from '@/data/projects';
import CardDetail from '@/components/CardDetail.astro';
---

<div
  class="grid grid-cols-1 gap-3.5 p-4 pb-8 md:grid-cols-2 lg:grid-cols-3 lg:p-8"
>
  {
    projects.map((project) => (
      <div
        id={`${project.id}`}
        data-card={`card-${project.id}`}
        class="project-card group relative flex cursor-pointer flex-col gap-y-6 p-5"
      >
        <span class="card-scan pointer-events-none absolute inset-0 rounded-[5px]" aria-hidden="true" />
        <div class="relative flex items-center justify-evenly gap-3">
          <Image
            src={project.projectLogo}
            alt={project.title}
            width={200}
            height={200}
            class="card-logo h-[85px] w-[100px] self-center object-contain"
            loading={'eager'}
          />
          <h2 class="card-title font-primary text-text text-[11px] lg:text-[12px]">
            {project.title}
          </h2>
        </div>

        <div class="text-text">
          {project.description && (
            <p class="font-secondary line-clamp-2 text-[16px] leading-tight">
              {project.description}
            </p>
          )}
          {project.techStack && (
            <p class="font-secondary text-[16px]">
              Techs: {project.techStack.join(', ')}
            </p>
          )}
          {project.year && (
            <p class="font-secondary text-[16px]">Year: {project.year}</p>
          )}
          <p class="font-secondary text-[16px]">Role: {project.role}</p>
        </div>

        <button
          type="button"
          data-open
          aria-label={`View details for ${project.title}`}
          class="open-btn absolute right-0 bottom-0 cursor-pointer"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="30"
            height="30"
            viewBox="0 0 24 24"
            aria-hidden="true"
            class="transition-all duration-200 ease-in-out group-hover:scale-[1.15] group-hover:rotate-90"
          >
            <path
              fill="none"
              stroke="#32292a"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 5v14m-7-7h14"
            />
          </svg>
        </button>
      </div>
    ))
  }
</div>

{projects.map((project) => <CardDetail project={project} />)}

<style>
  .project-card {
    background: linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.42),
      rgba(223, 196, 169, 0.34)
    );
    border: 2px solid color-mix(in srgb, var(--color-ink) 70%, transparent);
    border-radius: 7px;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.5),
      0 3px 0 -1px rgba(46, 38, 38, 0.3);
    transition:
      transform 0.18s steps(3, end),
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .project-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-primary);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.6),
      0 6px 0 -1px rgba(46, 38, 38, 0.35),
      0 12px 24px -10px rgba(26, 16, 16, 0.5),
      0 0 26px var(--glow-soft);
  }

  .card-scan {
    background: repeating-linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.05) 0px,
      rgba(0, 0, 0, 0.05) 1px,
      transparent 1px,
      transparent 4px
    );
    opacity: 0;
    transition: opacity 0.25s ease;
  }
  .project-card:hover .card-scan {
    opacity: 0.5;
  }

  .card-logo {
    transition: transform 0.25s steps(4, end);
  }
  .project-card:hover .card-logo {
    transform: scale(1.06);
  }

  .open-btn {
    background: linear-gradient(180deg, var(--color-primary), var(--color-secondary));
    border: 2px solid var(--color-ink);
    border-right: none;
    border-bottom: none;
    border-top-left-radius: 6px;
    box-shadow: inset 1px 1px 0 rgba(255, 220, 190, 0.4);
    transition: box-shadow 0.2s ease;
  }
  .project-card:hover .open-btn {
    box-shadow:
      inset 1px 1px 0 rgba(255, 220, 190, 0.5),
      0 0 16px var(--glow-mid);
  }
</style>

<script>
  // Explicit open/close — no reliance on the (still unevenly supported)
  // command/commandfor Invoker API, so the same flow works in every browser.
  const cards = document.querySelectorAll<HTMLElement>('[data-card]');

  const getDialog = (id: string) =>
    document.getElementById(`dialog-${id}`) as HTMLDialogElement | null;

  function openDialog(id: string) {
    const dialog = getDialog(id);
    if (!dialog || dialog.open) return;
    // Only one modal at a time.
    document.querySelector<HTMLDialogElement>('.card-detail[open]')?.close();
    dialog.showModal();
    window.history.pushState(null, '', `#${id}`);
  }

  function openModalFromHash() {
    const id = window.location.hash.replace('#', '');
    if (!id) return;
    const dialog = getDialog(id);
    if (dialog && !dialog.open) dialog.showModal();
  }

  openModalFromHash();
  window.addEventListener('hashchange', openModalFromHash);

  // Clicking anywhere on a card (including the "+" button, which bubbles here)
  // opens that project's modal.
  cards.forEach((card) => {
    card.addEventListener('click', () => openDialog(card.id));
  });

  const dialogs = document.querySelectorAll<HTMLDialogElement>('.card-detail');

  dialogs.forEach((dialog) => {
    dialog.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;

      // Close button (rendered visually outside the box).
      if (target.closest('[data-close]')) {
        dialog.close();
        return;
      }

      // Click on the dimmed backdrop (outside the dialog box) closes it.
      const rect = dialog.getBoundingClientRect();
      const clickedInside =
        event.clientX >= rect.left &&
        event.clientX <= rect.right &&
        event.clientY >= rect.top &&
        event.clientY <= rect.bottom;

      if (!clickedInside) dialog.close();
    });

    dialog.addEventListener('close', () => {
      window.history.pushState(
        null,
        '',
        window.location.pathname + window.location.search,
      );
    });
  });
</script>
