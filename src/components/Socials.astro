---
import Icons from './Icons.astro';

const { name, url, icon } = Astro.props;
---

<a
  href={url}
  target="_blank"
  rel="noopener noreferrer"
  class="social-link font-primary text-text flex items-center gap-x-2 rounded-md px-2 py-2 text-[11px] leading-0"
  ><Icons name={icon} /><span>{name}</span>
  <span class="ml-auto opacity-0 transition-opacity" aria-hidden="true">↗</span></a
>

<style>
  .social-link {
    border: 2px solid transparent;
    transition:
      border-color 0.18s ease,
      background 0.18s ease,
      transform 0.15s steps(2, end);
  }
  .social-link:hover {
    border-color: color-mix(in srgb, var(--color-ink) 60%, transparent);
    background: rgba(255, 255, 255, 0.35);
    transform: translateX(3px);
  }
  .social-link:hover span:last-child {
    opacity: 0.7;
  }
  .social-link:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }
</style>
