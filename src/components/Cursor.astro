<svg
  xmlns="http://www.w3.org/2000/svg"
  class="retro-cursor hidden"
  width="18"
  height="18"
  viewBox="0 0 11 11"
  shape-rendering="crispEdges"
  aria-hidden="true"
>
  <!-- 4-point rays (amber) — only the tips peek past the body -->
  <g fill="#ffb066">
    <rect x="5" y="0" width="1" height="11"></rect>
    <rect x="0" y="5" width="11" height="1"></rect>
  </g>
  <!-- star body (cream diamond) -->
  <g fill="#fff6e8">
    <rect x="5" y="2" width="1" height="1"></rect>
    <rect x="4" y="3" width="3" height="1"></rect>
    <rect x="3" y="4" width="5" height="1"></rect>
    <rect x="2" y="5" width="7" height="1"></rect>
    <rect x="3" y="6" width="5" height="1"></rect>
    <rect x="4" y="7" width="3" height="1"></rect>
    <rect x="5" y="8" width="1" height="1"></rect>
  </g>
  <!-- hot center cross (white) -->
  <g fill="#ffffff">
    <rect x="5" y="4" width="1" height="3"></rect>
    <rect x="4" y="5" width="3" height="1"></rect>
  </g>
</svg>

<style>
  .retro-cursor {
    position: absolute;
    left: 50%;
    top: 50%;
    margin: -9px 0 0 -9px;
    transform-origin: center;
    animation: sparkle-pulse 1.2s ease-in-out infinite;
    will-change: transform, opacity, filter;
  }

  @keyframes sparkle-pulse {
    0%,
    100% {
      transform: scale(0.85);
      opacity: 0.8;
      filter: drop-shadow(0 0 3px var(--glow-hot));
    }
    45% {
      transform: scale(1.18);
      opacity: 1;
      filter: drop-shadow(0 0 7px var(--glow-hot)) drop-shadow(0 0 3px #fff6e8);
    }
    72% {
      transform: scale(0.96);
      opacity: 0.92;
    }
  }
</style>
