---
import Cursor from '../components/Cursor.astro';

const { url, text } = Astro.props;

// Tiny pixel glyph per destination — keeps the game-menu feel.
const glyphFor = (label: string) => {
  switch (label.toLowerCase()) {
    case 'projects':
      // stacked tiles / cartridge
      return 'M2 3h12v2H2zM2 7h12v2H2zM2 11h12v2H2z';
    case 'about':
      // character bust
      return 'M6 2h4v4H6zM4 8h8v6H4z';
    default:
      return 'M3 7h10v2H3z';
  }
};
---

<a
  href={url}
  class="menu-link font-primary group relative flex w-full items-center gap-3 px-4 py-3.5 text-[clamp(0.7rem,1.1vw,1rem)] uppercase lg:gap-4 lg:px-6 lg:py-4"
  transition:name=`route-${text}`
>
  <span class="cursor-slot relative flex w-4 shrink-0 justify-center lg:w-5">
    <Cursor />
  </span>

  <svg
    class="glyph h-4 w-4 shrink-0 lg:h-5 lg:w-5"
    viewBox="0 0 16 16"
    aria-hidden="true"
    fill="currentColor"
    shape-rendering="crispEdges"
  >
    <path d={glyphFor(text)}></path>
  </svg>

  <span class="label flex-1 text-left tracking-wide">{text}</span>

  <span class="chevron text-[0.7em] opacity-60" aria-hidden="true">▶</span>
</a>

<style>
  .menu-link {
    color: var(--color-text);
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--color-tertiary) 88%, white),
      color-mix(in srgb, var(--color-sand) 86%, transparent)
    );
    border: 3px solid var(--color-ink);
    border-radius: 6px;
    box-shadow:
      inset 0 2px 0 rgba(255, 255, 255, 0.35),
      inset 0 -3px 0 rgba(46, 38, 38, 0.16),
      0 4px 0 -1px rgba(46, 38, 38, 0.4),
      0 0 0 1px rgba(0, 0, 0, 0.25);
    transition:
      transform 0.12s steps(3, end),
      box-shadow 0.18s ease,
      background 0.18s ease,
      color 0.12s steps(2, end);
  }

  .glyph {
    color: var(--color-rust);
    transition:
      color 0.15s ease,
      transform 0.2s steps(3, end);
  }

  .chevron {
    transition:
      transform 0.2s steps(3, end),
      opacity 0.15s ease;
  }

  /* Hover (pointer users) mirrors the active highlight subtly */
  .menu-link:hover {
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--color-tertiary) 96%, white),
      var(--color-sand)
    );
  }

  .menu-link:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }
</style>
