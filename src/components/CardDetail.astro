---
import type { Project } from '@/types/projectsTypes';
import { Image } from 'astro:assets';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<dialog
  id={`dialog-${project.id}`}
  aria-labelledby={`dialog-title-${project.id}`}
  class="card-detail modal-panel flex w-[90%] max-w-2xl flex-col items-center gap-6 overflow-visible p-6 lg:items-start"
>
  <button
    type="button"
    data-close
    aria-label="Close"
    class="close-btn pixel-chip font-primary absolute top-[-43px] right-4 cursor-pointer rounded-b-none px-3 py-1.5 transition-all hover:brightness-110"
  >
    X
  </button>

  <div class="flex shrink-0 flex-col justify-center gap-y-5 lg:w-[38%]">
    <Image
      src={project.projectLogo}
      alt={project.title}
      width={400}
      height={400}
      class="h-full max-h-[100px] w-full max-w-[140px] object-contain"
      loading={'eager'}
    />
    <h3
      id={`dialog-title-${project.id}`}
      class="font-primary text-text text-[12px] lg:text-[13px]"
    >
      {project.title}
    </h3>
  </div>

  <div class="flex flex-1 flex-col gap-y-3">
    <p class="font-secondary text-[18px] leading-snug tracking-[0px]">
      {project.description}
    </p>

    <div class="meta font-secondary flex flex-col gap-y-0.5 text-[16px]">
      {project.techStack && <p>Tech Stack: {project.techStack?.join(', ')}</p>}
      {project.year && <p>Year: {project.year}</p>}
      <p>Role: {project.role}</p>
    </div>
  </div>

  <a
    href={project.link}
    target="_blank"
    rel="noopener noreferrer"
    class="site-link font-primary text-tertiary mt-1 flex w-fit items-center gap-2 px-4 py-2.5 text-[10px] uppercase lg:text-[11px]"
  >
    <span class="arrow" aria-hidden="true">▶</span> View Page
  </a>
</dialog>

<style>
  .modal-panel {
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--color-tertiary) 96%, white),
      var(--color-sand)
    );
    border: 3px solid var(--color-ink);
    border-radius: 8px;
    box-shadow:
      inset 0 0 0 2px color-mix(in srgb, var(--color-primary) 22%, transparent),
      inset 0 3px 0 rgba(255, 255, 255, 0.45),
      0 0 0 1px rgba(0, 0, 0, 0.4),
      0 18px 50px -10px rgba(26, 16, 16, 0.7),
      0 0 40px var(--glow-mid);
  }

  .site-link {
    background: linear-gradient(
      180deg,
      var(--color-primary),
      var(--color-secondary)
    );
    border: 3px solid var(--color-ink);
    border-radius: 6px;
    box-shadow:
      inset 0 2px 0 rgba(255, 220, 190, 0.45),
      0 3px 0 -1px rgba(46, 38, 38, 0.5),
      0 0 16px var(--glow-soft);
    transition:
      transform 0.15s steps(2, end),
      box-shadow 0.2s ease;
  }
  .site-link:hover {
    transform: translateY(-2px);
    box-shadow:
      inset 0 2px 0 rgba(255, 220, 190, 0.55),
      0 4px 0 -1px rgba(46, 38, 38, 0.5),
      0 0 22px var(--glow-mid);
  }
  .site-link .arrow {
    transition: transform 0.2s steps(2, end);
  }
  .site-link:hover .arrow {
    transform: translateX(3px);
  }

  .card-detail[open] {
    scale: 1;
    transition: scale 0.3s ease;

    @starting-style {
      scale: 0;
    }
  }

  .card-detail {
    top: 50%;
    left: 50%;
    translate: -50% -50%;
    transition:
      scale 0.3s ease,
      display 0.3s ease allow-discrete;
    scale: 0;
    backdrop-filter: blur(12px);
  }

  .card-detail::backdrop {
    background-color: rgba(0, 0, 0, 0.35);
    backdrop-filter: blur(3px);
    pointer-events: all;
  }
</style>
