---
import type { Project } from '@/types/projectsTypes';
import { Image } from 'astro:assets';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<dialog
  id={`dialog-${project.id}`}
  aria-labelledby={`dialog-title-${project.id}`}
  class="card-detail bg-tertiary border-secondary flex w-[90%] max-w-2xl flex-col items-center gap-6 overflow-visible rounded-[10px] border-4 p-6 lg:items-start"
>
  <button
    commandfor={`dialog-${project.id}`}
    command="close"
    aria-label="Close"
    class="close-btn border-secondary font-primary text-tertiary absolute top-[-43px] right-4 cursor-pointer rounded-tl-[10px] rounded-tr-[10px] border-4 bg-[#A54517] px-2.5 py-[5px] transition-opacity hover:opacity-100"
  >
    X
  </button>

  <div class="flex shrink-0 flex-col justify-center gap-y-5 lg:w-[38%]">
    <Image
      src={project.projectLogo}
      alt={project.title}
      width={400}
      height={400}
      class="h-full max-h-[100px] w-full max-w-[140px] object-contain"
      loading={'eager'}
    />
    <h3
      id={`dialog-title-${project.id}`}
      class="font-primary text-text text-[12px] lg:text-[13px]"
    >
      {project.title}
    </h3>
  </div>

  <div class="flex flex-1 flex-col gap-y-3">
    <p class="font-secondary text-[18px] leading-snug tracking-[0px]">
      {project.description}
    </p>

    <div class="meta font-secondary flex flex-col gap-y-0.5 text-[16px]">
      {project.techStack && <p>Tech Stack: {project.techStack?.join(', ')}</p>}
      {project.year && <p>Year: {project.year}</p>}
      <p>Role: {project.role}</p>
    </div>
  </div>

  <a
    href={project.link}
    target="_blank"
    rel="noopener noreferrer"
    class="site-link font-secondary text-primary mt-1 w-fit text-[14px] uppercase underline lg:text-[18px]"
  >
    View Page
  </a>
</dialog>

<style>
  .card-detail[open] {
    scale: 1;
    transition: scale 0.3s ease;

    @starting-style {
      scale: 0;
    }
  }

  .card-detail {
    top: 50%;
    left: 50%;
    translate: -50% -50%;
    transition:
      scale 0.3s ease,
      display 0.3s ease allow-discrete;
    scale: 0;
    backdrop-filter: blur(12px);
  }

  .card-detail::backdrop {
    background-color: rgba(0, 0, 0, 0.35);
    backdrop-filter: blur(3px);
    pointer-events: all;
  }
</style>
