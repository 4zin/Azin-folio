---
import Nav from '@/components/Nav.astro';
import MuteButton from '@/components/MuteButton.astro';
import Layout from '@/layouts/Layout.astro';
import { navigationItems } from '@/data/navigation-items';
import complementBg from '@/assets/images/complement-bg.webp';
import { Image } from 'astro:assets';

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Camilo Rodelo',
  alternateName: 'Az1nDev',
  url: 'https://azindev.vercel.app',
  jobTitle: 'Frontend Developer',
  knowsAbout: [
    'React',
    'TypeScript',
    'Astro',
    'Shopify',
    'Next.js',
    'Tailwind CSS',
  ],
  sameAs: [
    'https://github.com/4zin',
    'https://www.linkedin.com/in/camilo-rodelo/',
  ],
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Az1nDev Portfolio',
  url: 'https://azindev.vercel.app',
};
---

<Layout
  title="Camilo Rodelo — Frontend Developer | React, TypeScript, Astro"
  description="Frontend Developer building fast, accessible web experiences with React, TypeScript and Astro. Retro-gaming inspired portfolio of Camilo Rodelo (Az1nDev)."
  hideHeader={true}
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(personSchema)}
    slot="head"
  />
  <script
    type="application/ld+json"
    set:html={JSON.stringify(websiteSchema)}
    slot="head"
  />
  <div class="flex h-dvh flex-col">
    <section
      class="flex shrink-0 flex-col items-center px-4 py-3 lg:px-6 lg:py-4"
    >
      <div class="flex w-full justify-end">
        <MuteButton />
      </div>
      <h1
        class="font-primary text-primary flex flex-col items-center pt-2 text-[clamp(0.75rem,1.2vw,2rem)] uppercase lg:pt-4"
      >
        <span class="leading-[100%]" transition:name="brand-tagline"
          >Frontend Developer</span
        >
        <span
          class="font-title text-[clamp(4.5rem,10.5vw,12.5rem)] leading-[100%] font-extrabold tracking-normal text-[#32292A]"
          transition:name="brand-name">Az1n</span
        >
      </h1>
    </section>

    <section
      class="relative min-h-[45dvh] flex-1 bg-[url('../assets/images/new-bg.webp')] bg-cover bg-center bg-no-repeat"
    >
      <Image
        src={complementBg}
        alt=""
        loading="eager"
        class="absolute bottom-28 h-full w-full object-cover object-top"
      />
    </section>

    <!-- Section 3: navigation -->
    <section class="flex shrink-0 justify-center py-4 lg:py-6">
      <retro-menu
        class="w-full max-w-lg"
        selector=".options"
        active-class="active"
        enable-mouse-navigation="true"
      >
        <nav>
          <ul
            class="flex flex-col items-stretch gap-y-2 px-4 lg:flex-row lg:items-center lg:justify-center lg:gap-x-5 lg:px-0"
          >
            {
              navigationItems.map(({ url, text }) => (
                <li class="options flex items-center gap-x-2">
                  <Nav url={url} text={text} />
                </li>
              ))
            }
          </ul>
        </nav>
      </retro-menu>
    </section>
  </div>
</Layout>

<style>
  .options :global(a) {
    color: #32292a;
  }

  .options.active :global(a) {
    color: var(--color-text);
    font-size: clamp(0.75rem, 1.2vw, 1.125rem);
    background-color: var(--color-secondary);
  }

  .options.selected {
    animation: blink 0.25s infinite;
  }

  @keyframes blink {
    0% {
      opacity: 1;
    }
    50% {
      opacity: 0.45;
    }
    100% {
      opacity: 1;
    }
  }
</style>

<script>
  import RetroMenu from '@/scripts/game-menu';

  let retroMenu: RetroMenu | null = null;

  function toggleCursor() {
    const options = document.querySelectorAll('.options');
    options.forEach((option) => {
      const cursor = option.querySelector('.retro-cursor');
      if (cursor) {
        if (option.classList.contains('active')) {
          cursor.classList.remove('hidden');
        } else {
          cursor.classList.add('hidden');
        }
      }
    });
  }

  function initializeMenu() {
    retroMenu = document.querySelector('retro-menu') as RetroMenu;
    if (retroMenu) {
      toggleCursor();
      retroMenu.addEventListener('active-changed', toggleCursor);
    }
  }

  function cleanupMenu() {
    if (retroMenu) {
      retroMenu.removeEventListener('active-changed', toggleCursor);
      retroMenu.destroy();
      retroMenu = null;
    }
  }

  document.addEventListener('DOMContentLoaded', initializeMenu);
  document.addEventListener('astro:page-load', initializeMenu);
  document.addEventListener('astro:before-swap', cleanupMenu);
</script>
