---
import { Image } from 'astro:assets';
import Layout from '@/layouts/Layout.astro';
import MuteButton from '@/components/MuteButton.astro';
import Socials from '@/components/Socials.astro';
import AboutInfo from '@/components/AboutInfo.astro';
import FeaturedInfo from '@/components/FeaturedInfo.astro';
import Skills from '@/components/SkillsInfo.astro';

import Avatar from '@/assets/images/avatar.webp';
import Profile from '@/assets/images/profile.webp';
import { socialMedia } from '@/data/socials';
---

<Layout
  title="About Me - Az1nDev"
  description="Learn more about Camilo Rodelo (Az1nDev), Frontend Developer with experience in modern web application development, technical skills and featured projects."
  hideHeader={true}
>
  <div
    class="min-h-[100dvh] bg-[url('../assets/images/bg-alternative.webp')] bg-cover bg-center bg-no-repeat"
  >
    <section class="flex items-center justify-between px-4 pt-4">
      <a href="/" class="flex flex-col items-center">
        <span
          class="font-primary text-tertiary text-[10px] leading-none font-extrabold uppercase lg:text-[14px]"
          transition:name="brand-tagline">Frontend Developer</span
        >
        <span
          class="font-title text-tertiary text-[clamp(3rem,12vw,5rem)] leading-none font-extrabold uppercase"
          transition:name="brand-name">Az1n</span
        >
      </a>
      <MuteButton />
    </section>

    <section
      class="3xl:h-[65dvh] flex flex-col px-4 pt-4 pb-4 lg:mx-auto lg:mt-40 lg:h-[70dvh] lg:w-full lg:max-w-[80%] lg:flex-row lg:items-stretch lg:gap-x-4 lg:pt-0"
    >
      <div
        class="profile-card bg-tertiary relative top-[50px] flex h-full min-h-[200px] gap-y-10 rounded-md px-3 pt-3 lg:top-0 lg:w-[280px] lg:shrink-0 lg:flex-col lg:items-center lg:px-6 lg:pt-8"
      >
        <profile-image
          class="group border-secondary relative h-[136px] w-[136px] shrink-0 cursor-pointer overflow-hidden rounded-[10px] border-4 lg:h-[50%] lg:w-full"
        >
          <Image
            src={Avatar}
            width={430}
            height={430}
            alt="Az1nDev"
            class="avatar h-full w-full object-cover object-top transition-all duration-300 ease-in-out group-hover:opacity-0 lg:h-[130%]"
            loading="eager"
          />
          <Image
            src={Profile}
            width={200}
            height={200}
            alt="Az1nDev"
            class="profile absolute inset-0 h-full w-full object-cover object-top opacity-0 transition-all duration-300 ease-in-out group-hover:opacity-100"
            loading="eager"
          />
        </profile-image>
        <div
          class="flex w-full flex-col justify-start gap-y-2.5 rounded-[10px] border-[#32292A] px-3 py-3.5 lg:border"
        >
          {
            socialMedia.map((item) => (
              <Socials name={item.name} url={item.url} icon={item.icon} />
            ))
          }
        </div>
      </div>

      <about-component class="flex min-h-0 flex-1 flex-col">
        <div class="font-primary flex items-center gap-x-1.5">
          <button
            class="leftNav text-primary hidden justify-center rounded-md border-2 border-black bg-[#e0e0e0] px-3 py-2 lg:flex"
            >Q</button
          >

          <nav class="relative z-10 flex-1 md:top-2.5">
            <ul class="about-options flex w-full gap-x-1.5 px-2.5">
              <li
                data-option="0"
                class="selected-option border-secondary font-primary flex-1 cursor-pointer rounded-tl-[10px] rounded-tr-[10px] border-4 text-[10px]"
              >
                <button class="uppercase">Skills</button>
              </li>
              <li
                data-option="1"
                class="border-secondary font-primary flex-1 cursor-pointer rounded-tl-[10px] rounded-tr-[10px] border-4 text-[10px]"
              >
                <button class="uppercase">Featured</button>
              </li>
              <li
                data-option="2"
                class="border-secondary font-primary flex-1 cursor-pointer rounded-tl-[10px] rounded-tr-[10px] border-4 text-[10px]"
              >
                <button class="uppercase">About</button>
              </li>
            </ul>
          </nav>

          <button
            class="rightNav text-primary hidden justify-center rounded-md border-2 border-black bg-[#e0e0e0] px-3 py-2 lg:flex"
            >E</button
          >
        </div>

        <div
          class="border-secondary relative max-h-[60dvh] min-h-0 flex-1 items-center justify-center overflow-y-auto rounded-md border-4 bg-[#f1d8bf] p-4 md:p-8 lg:flex lg:max-h-none"
        >
          <span
            class="font-primary pointer-events-none absolute top-1.5 left-1.5 text-[10px] opacity-40 lg:top-3 lg:right-3 lg:text-[20px]"
            >✦</span
          >
          <span
            class="font-primary pointer-events-none absolute top-1.5 right-1.5 text-[10px] opacity-40 lg:top-3 lg:right-3 lg:text-[20px]"
            >✦</span
          >
          <Skills />
          <FeaturedInfo />
          <AboutInfo />
          <div
            class="mt-2 flex justify-between lg:absolute lg:right-1.5 lg:bottom-1.5 lg:left-1.5"
          >
            <span
              class="font-primary pointer-events-none text-[10px] opacity-40 lg:text-[20px]"
              >✦</span
            >
            <span
              class="font-primary pointer-events-none text-[10px] opacity-40 lg:text-[20px]"
              >✦</span
            >
          </div>
        </div>
      </about-component>
    </section>
  </div>
</Layout>

<style>
  .profile-card::after {
    content: '';
    position: absolute;
    width: 100%;
    height: 100%;
    background: #000;
    top: 0;
    left: 0;
    mask-image: linear-gradient(transparent 60%, #0000006e);
    pointer-events: none;

    @media screen and (width >= 1024px) {
      display: none;
    }
  }

  /* Mobile: 3 tabs equally distributed */
  .about-options[data-selected='0']::before {
    width: calc(33.33% - 12px);
    left: 6px;
  }
  .about-options[data-selected='1']::before {
    width: calc(33.33% - 12px);
    left: calc(33.33% + 6px);
  }
  .about-options[data-selected='2']::before {
    width: calc(33.33% - 12px);
    left: calc(66.67% + 6px);
  }

  @media screen and (min-width: 1024px) {
    .about-options[data-selected='0']::before {
      width: calc(100% / 3 - 90px);
      left: 30px;
    }
    .about-options[data-selected='1']::before {
      width: calc(100% / 3 - 100px);
      left: calc(100% / 3 + 35px);
    }
    .about-options[data-selected='2']::before {
      width: calc(100% / 3 - 110px);
      left: calc(100% / 3 * 2 + 60px);
    }
  }

  .about-options li {
    display: flex;
    justify-content: center;
    align-items: center;
    flex: 1;
    background: #a54517;
  }

  .about-options li.selected-option {
    background: var(--color-tertiary);
  }

  .about-options li button {
    position: relative;
    transition: color 0.3s ease;
    cursor: pointer;
    padding: 4px 8px;
  }

  .selected-option button {
    color: #000;
    font-weight: 600;
  }

  .about-options li:not(.selected-option) button {
    color: var(--color-text);
    -webkit-text-stroke: 0.8px #000;
    -webkit-text-fill-color: var(--color-text);
  }

  @keyframes pop {
    0% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.1);
    }
    100% {
      transform: scale(1);
    }
  }

  .selected-option {
    animation: pop 0.3s ease;
  }

  about-component .limited {
    animation: shake 0.3s;
  }

  @keyframes shake {
    0%,
    100% {
      transform: translateX(0);
    }
    25% {
      transform: translateX(-5px);
    }
    75% {
      transform: translateX(5px);
    }
  }

  :global(.selected-content) {
    display: grid;
  }
</style>

<script>
  import '@/scripts/about.ts';
</script>
